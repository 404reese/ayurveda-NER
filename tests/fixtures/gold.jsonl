{"lang": "hi", "text": "अश्वगंधा चूर्ण वात रोगों में उपयोगी है।", "entities": [["अश्वगंधा चूर्ण", "FORMULATION"], ["वात रोगों", "ROGA"]]}
{"lang": "hi", "text": "गिलोय और तुलसी का काढ़ा बुखार में दिया जाता है।", "entities": [["गिलोय", "DRAVYA"], ["तुलसी", "DRAVYA"], ["काढ़ा", "DOSAGE_FORM"], ["बुखार", "ROGA"]]}
