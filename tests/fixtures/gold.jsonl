{"lang": "hi", "text": "पित्त बढ़ने से सीने में जलन और अम्लपित्त होता है।", "entities": [["पित्त", "DOSHA"], ["सीने में जलन", "SYMPTOM"], ["अम्लपित्त", "ROGA"]]}
{"lang": "hi", "text": "कफ दोष के कारण खांसी और दमा होता है।", "entities": [["कफ दोष", "DOSHA"], ["खांसी", "ROGA"], ["दमा", "ROGA"]]}
{"lang": "hi", "text": "हल्दी और अदरक सूजन कम करते हैं।", "entities": [["हल्दी", "DRAVYA"], ["अदरक", "DRAVYA"], ["सूजन", "ROGA"]]}
{"lang": "hi", "text": "पंचकर्म में वमन, विरेचन, बस्ति, नस्य और रक्तमोक्षण शामिल हैं।", "entities": [["पंचकर्म", "PROCEDURE"], ["वमन", "PROCEDURE"], ["विरेचन", "PROCEDURE"], ["बस्ति", "PROCEDURE"], ["नस्य", "PROCEDURE"], ["रक्तमोक्षण", "PROCEDURE"]]}
